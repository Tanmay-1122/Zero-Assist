{
    "name": "hhgoa-website",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "description": "Premium marketing site for HHGOA — on-device intelligence.",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write ."
    },
    "dependencies": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.17.0",
        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5",
        "@vitejs/plugin-react": "^4.3.4",
        "eslint": "^9.17.0",
        "prettier": "^3.4.2",
        "typescript": "~5.7.2",
        "typescript-eslint": "^8.18.2",
        "vite": "^6.0.7"
    },
    "allowScripts": {
        "esbuild@0.25.12": true
    }
}
